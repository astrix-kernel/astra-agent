{
  "name": "@astra/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "tsx src/db/studio.ts"
  },
  "dependencies": {
    "@astra/core": "^0.1.0",
    "fastify": "^4.25.0",
    "@fastify/websocket": "^8.3.0",
    "@fastify/cors": "^8.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "zod": "^3.22.4",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "uuid": "^9.0.1",
    "better-sqlite3": "^9.2.2",
    "jose": "^5.2.0",
    "@fastify/cookie": "^9.1.0",
    "@fastify/helmet": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0"
  }
}