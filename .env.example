# Leave ASTRA_API_KEY empty to use explicit mock mode
ASTRA_API_KEY=
ASTRA_MODEL=gpt-4o-mini
ASTRA_BASE_URL=https://api.openai.com/v1
ASTRA_API_PORT=8787
ASTRA_WEB_ORIGIN=http://localhost:5173
ASTRA_WORKSPACE_ROOT=.
ASTRA_RATE_LIMIT=60
# Set to 1 only when you intentionally allow workspace writes
ASTRA_ALLOW_WRITE=0
